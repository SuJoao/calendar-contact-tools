BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Calendar Contact Tools Samples//EN
X-WR-CALNAME:Fictional mixed timezone calendar
BEGIN:VEVENT
UID:sample-utc@example.test
DTSTART:20260808T120000Z
DTEND:20260808T130000Z
SUMMARY:UTC sample
END:VEVENT
BEGIN:VEVENT
UID:sample-lisbon@example.test
DTSTART;TZID=Europe/Lisbon:20260808T120000
DTEND;TZID=Europe/Lisbon:20260808T130000
SUMMARY:Lisbon sample
END:VEVENT
BEGIN:VEVENT
UID:sample-floating@example.test
DTSTART:20260808T120000
DTEND:20260808T130000
SUMMARY:Floating sample
END:VEVENT
BEGIN:VEVENT
UID:sample-all-day@example.test
DTSTART;VALUE=DATE:20260808
DTEND;VALUE=DATE:20260809
SUMMARY:All-day sample
END:VEVENT
END:VCALENDAR
